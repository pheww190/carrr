# ---- Bluetooth: Bluedroid host (ESP32 = BLE + Classic) ----
# The controller is enabled in BLE-only mode at runtime in ble_srv.c
# (esp_bt_controller_enable(ESP_BT_MODE_BLE)), so no controller-mode
# Kconfig is forced here.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y

# ---- FreeRTOS tick: 1000 Hz for a clean 50 Hz control task ----
CONFIG_FREERTOS_HZ=1000

# ---- CPU ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Flash: your module is 4 MB (silences the "Detected size(4096k)
#      larger than the size in the binary image header(2048k)" warning) ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
